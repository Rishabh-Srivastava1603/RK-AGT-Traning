                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Invoice No: " &amp; Fields!InvoiceNo.Value &amp; vbCrLf &amp;
 "Posting Date: " &amp; Fields!PostingDate.Value &amp; vbCrLf &amp;
 "Due Date: " &amp; Fields!DueDate.Value &amp; vbCrLf &amp;
 "Currency: " &amp; Fields!CurrencyCode.Value</Value>
