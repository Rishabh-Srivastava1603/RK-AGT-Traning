  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function
Public Function GetSafeLogo(ByVal base64Str As Object) As Byte()
    Dim transparentPng As String = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
    If IsNothing(base64Str) Then Return System.Convert.FromBase64String(transparentPng)
    Dim str As String = CStr(base64Str).Trim()
    If str = "" Then Return System.Convert.FromBase64String(transparentPng)
    Try
        Return System.Convert.FromBase64String(str)
    Catch
        Return System.Convert.FromBase64String(transparentPng)
    End Try
End Function
</Code>
