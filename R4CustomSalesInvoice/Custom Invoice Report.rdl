                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="BILL TO:" &amp; vbCrLf &amp;
Fields!BillToName.Value &amp; " (" &amp; Fields!BillToNo.Value &amp; ")" &amp; vbCrLf &amp;
Fields!BillToAddressLine1.Value &amp;
IIF(Fields!BillToAddressLine2.Value = "", "", vbCrLf &amp; Fields!BillToAddressLine2.Value) &amp;
IIF(Fields!BillToAddressLine3.Value = "", "", vbCrLf &amp; Fields!BillToAddressLine3.Value) &amp;
IIF(Fields!BillToAddressLine4.Value = "", "", vbCrLf &amp; Fields!BillToAddressLine4.Value) &amp;
