                          <rd:DefaultName>Textbox55</rd:DefaultName>
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!CompanyName.Value &amp; vbCrLf &amp;
 Fields!CompanyAddress.Value &amp; vbCrLf &amp;
 "Phone: " &amp; Fields!CompanyPhone.Value &amp; "  |  VAT Reg No: " &amp; Fields!CompanyVATRegNo.Value</Value>
                                  <Style />
                                </TextRun>
                              </TextRuns>
